# ──────────────────────────────────────────────
# Equipement Ouarzazate — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# PostgreSQL connection (Neon / Vercel Postgres)
# Used by Prisma for pooled connections (via PgBouncer)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct connection (bypasses PgBouncer — required for migrations)
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Seed script — admin password (optional, defaults to dev password if unset)
# Set this for non-development deployments. Change after first login.
# SEED_ADMIN_PASSWORD="YourSecurePassword123!"
