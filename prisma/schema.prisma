/// Equipement Ouarzazate — Database Schema
///
/// PostgreSQL database schema for the construction materials catalog.
/// All models align with the frontend TypeScript interfaces in src/types/.
///
/// @see src/types/product.ts
/// @see src/types/category.ts
/// @see src/types/admin.ts

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────
// Auth Models
// ──────────────────────────────────────────────

/// User roles for role-based access control.
/// Values align with AdminRole in src/types/admin.ts:
///   OWNER   → 'owner'   (full access)
///   MANAGER → 'manager' (can manage products/categories)
///   VIEWER  → 'viewer'  (read-only dashboard access)
enum UserRole {
  OWNER
  MANAGER
  VIEWER
}

/// Admin user account. Maps to AdminUser in src/types/admin.ts.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  displayName  String
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

/// Session for Lucia v3 auth. Fields match Lucia's expected schema.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ──────────────────────────────────────────────
// Catalog Models
// ──────────────────────────────────────────────

/// Product category. Maps to Category in src/types/category.ts.
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

/// Variation type enum. Maps to ProductVariation.type union in src/types/product.ts.
enum VariationType {
  COLOR
  SIZE
  MATERIAL
}

/// Product in the catalog. Maps to Product in src/types/product.ts.
/// No price field — customers contact via WhatsApp for pricing.
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  categoryId  String
  isNew       Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Full-text search vector — managed by PostgreSQL trigger, not Prisma.
  /// Included here to prevent schema drift warnings on `prisma migrate`.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// Restrict deletion if products exist — admin must reassign or delete products first (I8).
  category   Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  variations ProductVariation[]

  @@index([categoryId])
  @@index([slug])
  @@index([isPublished])
  @@index([isFeatured])
  @@map("products")
}

/// Product image for gallery display. Maps to ProductImage in src/types/product.ts.
model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  alt        String
  order      Int      @default(0)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

/// Product variation (color, size, material). Maps to ProductVariation in src/types/product.ts.
model ProductVariation {
  id        String        @id @default(cuid())
  productId String
  type      VariationType
  name      String
  value     String
  createdAt DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variations")
}

// ──────────────────────────────────────────────
// Communication Models
// ──────────────────────────────────────────────

/// Contact message status workflow.
enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

/// Contact form submission from visitors.
/// Maps to ContactFormRequest in src/types/api.ts.
model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  /// Optional product reference — set when a visitor's inquiry is about a specific product (TI3).
  /// Not a foreign key because the product may be deleted after the message is sent.
  productId String?
  status    ContactMessageStatus @default(NEW)
  notes     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@map("contact_messages")
}

/// Newsletter subscriber. Maps to NewsletterSubscriber in src/types/newsletter.ts.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isSubscribed   Boolean   @default(true)
  source         String?
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

// ──────────────────────────────────────────────
// Audit Models
// ──────────────────────────────────────────────

/// Audit log entry for tracking admin actions.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────
// Analytics Models
// ──────────────────────────────────────────────

/// Anonymous analytics event for tracking product views, WhatsApp clicks, searches, and category views.
/// No PII is stored — sessionId is a random UUID from sessionStorage.
/// Raw events are retained for 12 months.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String   // 'product_view' | 'whatsapp_click' | 'search' | 'category_view'
  productId   String?
  categoryId  String?
  query       String?  // Search events: the search query text
  resultCount Int?     // Search events: number of results returned
  metadata    Json?    // Extensible: referrer, user-agent class, etc.
  sessionId   String?  // Random UUID from sessionStorage (no PII)
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([productId])
  @@index([query])
  @@map("analytics_events")
}
